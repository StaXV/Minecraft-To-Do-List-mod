{
	"schemaVersion": 1,
	"id": "memo",
	"version": "${version}",
	"name": "To-Do List",
	"description": "游戏内随手记录待办事项的 To-Do List Mod。支持编辑、完成标记、自动保存，并可在游戏界面上固定一个小型待办清单。",
	"authors": [
		"StaXV"
	],
	"contact": {
		"sources": "https://github.com/StaXV/memo"
	},
	"license": "MIT",
	"icon": "assets/memo/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.staxv.memo.MemoMod"
		],
		"client": [
			"com.staxv.memo.client.MemoModClient"
		],
		"modmenu": [
			"com.staxv.memo.client.modmenu.MemoModMenuApi"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
